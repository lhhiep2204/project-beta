  "grammar_points": [
    {
      "id": "29418494-a0c8-4076-a2d7-e0151d0120a6",
      "editorial_key": "appearance",
      "title": {
        "en": "Appearance and imminent events",
        "vi": "Trông có vẻ và sắp xảy ra"
      },
      "explanation": {
        "en": "ます stem plus そうです predicts an imminent event; adjective stem plus そうです infers from appearance. いい becomes よさそう and ない becomes なさそう.",
        "vi": "Thân ます + そうです dự đoán điều sắp xảy ra; thân tính từ + そうです suy đoán từ vẻ ngoài. いい thành よさそう, ない thành なさそう."
      },
      "notes": {
        "en": "Do not attach そう directly to a noun as a general rule; appearance differs from lesson 47 hearsay.",
        "vi": "Không thêm そう trực tiếp vào danh từ như một quy tắc; vẻ ngoài khác tin nghe được ở bài 47."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 135,
          "pdf_page_end": 135,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "1",
      "origin": "independently_authored"
    },
    {
      "id": "9faca396-86fa-4f6c-a660-6b71d31e38a6",
      "editorial_key": "go_return",
      "title": {
        "en": "Going to do something and returning",
        "vi": "Đi làm rồi quay lại"
      },
      "explanation": {
        "en": "て来ます can mean going to perform an action and returning; the action location takes で. へ行って来ます states a destination and return.",
        "vi": "てきます nói đi thực hiện hành động rồi trở lại; địa điểm thực hiện dùng で. へ行ってきます nói đi đến nơi rồi quay lại."
      },
      "notes": {
        "en": "The return is to the point of departure or the conversational reference point.",
        "vi": "Việc quay lại gắn với điểm xuất phát hoặc ngữ cảnh hội thoại."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 135,
          "pdf_page_end": 136,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "2",
      "origin": "independently_authored"
    },
    {
      "id": "af347cac-bb09-434b-b70e-bbb25d515cfd",
      "editorial_key": "casual_request",
      "title": {
        "en": "Requests with てくれませんか",
        "vi": "Nhờ bằng てくれませんか"
      },
      "explanation": {
        "en": "てくれませんか asks for help more softly than てください.",
        "vi": "てくれませんか nhờ người nghe giúp, mềm hơn てください."
      },
      "notes": {
        "en": "For greater deference, consider てくださいませんか or ていただけませんか.",
        "vi": "Với hoàn cảnh cần kính trọng hơn, cân nhắc てくださいませんか hoặc ていただけませんか."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 136,
          "pdf_page_end": 136,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "3",
      "origin": "independently_authored"
    }
  ],
