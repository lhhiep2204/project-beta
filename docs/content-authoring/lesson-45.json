  "grammar_points": [
    {
      "id": "54f1c432-d22b-4491-b2db-5ac2695db1f4",
      "editorial_key": "case",
      "title": {
        "en": "In the event that",
        "vi": "Trong trường hợp"
      },
      "explanation": {
        "en": "A plain clause plus 場合は sets a situation for instructions or a response. Nouns take の and な-adjectives take な before 場合.",
        "vi": "Mệnh đề thường + 場合は đặt tình huống để nêu hướng xử lý. Danh từ dùng の, tính từ な dùng な trước 場合."
      },
      "notes": {
        "en": "Common in contingency instructions; it does not replace every use of とき.",
        "vi": "Thường gặp trong hướng dẫn xử lý sự cố; không đồng nghĩa mọi cách dùng とき."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 147,
          "pdf_page_end": 147,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "1",
      "origin": "independently_authored"
    },
    {
      "id": "dcc6e0b7-f444-4a15-9fbb-e7b1b2e2e4f8",
      "editorial_key": "noni",
      "title": {
        "en": "Unexpected contrast with のに",
        "vi": "Trái dự tính với のに"
      },
      "explanation": {
        "en": "Plain form plus のに connects a fact with an unexpected result, often conveying surprise or dissatisfaction. Nouns and な-adjectives use なのに.",
        "vi": "Thể thường + のに nối sự thật với kết quả trái dự tính, thường kèm ngạc nhiên hoặc không hài lòng. Danh từ và tính từ な dùng なのに."
      },
      "notes": {
        "en": "Unlike hypothetical even-if ても, のに concerns an unexpected outcome; it does not simply introduce an invitation or command.",
        "vi": "Khác ても nói giả định dù thế nào; không dùng のに để nối một lời rủ hay mệnh lệnh đơn thuần."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 147,
          "pdf_page_end": 148,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "2",
      "origin": "independently_authored"
    }
  ],
