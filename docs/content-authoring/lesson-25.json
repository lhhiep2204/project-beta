  "grammar_points": [
    {
      "id": "5db51e0e-fd30-4991-a01c-e15a0f6a0d6e",
      "editorial_key": "topic_1",
      "title": {
        "en": "Hypothetical conditions with たら",
        "vi": "Điều kiện giả định với たら"
      },
      "explanation": {
        "en": "Add ら to a plain past form to make a condition: verb たら, い-adjective かったら, noun or な-adjective だったら. The main clause can state a result, wish, invitation or request.",
        "vi": "Thêm ら sau dạng thông thường quá khứ để đặt điều kiện: động từ たら, tính từ い かったら, danh từ／な だったら. Mệnh đề chính nêu kết quả, mong muốn, lời mời hoặc yêu cầu."
      },
      "notes": {
        "en": "The past-form base does not mean the condition already happened in the past.",
        "vi": "Dạng quá khứ tạo điều kiện không có nghĩa điều kiện đã xảy ra trong quá khứ."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 177,
          "pdf_page_end": 178,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "1",
      "origin": "independently_authored"
    },
    {
      "id": "e219399c-6e33-4299-8388-fc5b0856697d",
      "editorial_key": "topic_2",
      "title": {
        "en": "Once an action is complete with たら",
        "vi": "Khi đã xong một việc với たら"
      },
      "explanation": {
        "en": "Vたら can also mean that once an action or expected milestone is complete, the next action follows.",
        "vi": "Vたら còn nói sau khi một hành động hay mốc chắc chắn hoàn tất thì làm việc tiếp theo."
      },
      "notes": {
        "en": "The next action follows that completion point; this is not a loose activity list.",
        "vi": "Chọn hành động tiếp theo xảy ra sau mốc đó, không hiểu như liệt kê chung."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 177,
          "pdf_page_end": 178,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "2",
      "origin": "independently_authored"
    },
    {
      "id": "132deb3b-3797-41d5-836d-0ac1248aa251",
      "editorial_key": "topic_3",
      "title": {
        "en": "Concession with ても",
        "vi": "Dù… vẫn… với ても"
      },
      "explanation": {
        "en": "て-form + も says the result holds despite a condition that might suggest otherwise. Negative verbs use なくても, い-adjectives くても, and nouns or な-adjectives でも.",
        "vi": "Thể て + も nói kết quả vẫn giữ dù điều kiện ngược dự đoán. Phủ định động từ dùng なくても; tính từ い dùng くても; danh từ và な dùng でも."
      },
      "notes": {
        "en": "Distinguish concessive ても from permission expressed by てもいい.",
        "vi": "Phân biệt ても nghĩa nhượng bộ với てもいい là cho phép."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 177,
          "pdf_page_end": 178,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "3",
      "origin": "independently_authored"
    },
    {
      "id": "3bdf24ec-adf4-44ed-876c-125db7374d03",
      "editorial_key": "topic_4",
      "title": {
        "en": "Emphasize a supposition with もし",
        "vi": "Nhấn mạnh giả định bằng もし"
      },
      "explanation": {
        "en": "もし often introduces a たら condition to make the hypothetical nature explicit.",
        "vi": "もし thường đứng đầu câu điều kiện たら để báo rõ người nói đang giả sử một tình huống."
      },
      "notes": {
        "en": "もし alone does not complete the condition; the appropriate conditional form is still required.",
        "vi": "もし không tự hoàn thành câu điều kiện; vẫn cần dạng điều kiện thích hợp."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 177,
          "pdf_page_end": 178,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "4",
      "origin": "independently_authored"
    },
    {
      "id": "534d5329-6515-42a1-8a0f-5b7236780f8f",
      "editorial_key": "topic_5",
      "title": {
        "en": "Subjects of subordinate clauses with が",
        "vi": "Chủ ngữ mệnh đề phụ với が"
      },
      "explanation": {
        "en": "A separate subject in たら, ても and many subordinate clauses such as とき and まえに normally takes が.",
        "vi": "Chủ ngữ riêng trong mệnh đề たら、ても và nhiều mệnh đề phụ như とき、まえに thường dùng が."
      },
      "notes": {
        "en": "は can add a different topical or contrastive meaning; the basic pattern here uses が.",
        "vi": "は có thể tạo nghĩa chủ đề hoặc đối chiếu khác; mẫu cơ bản ở đây dùng が."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 177,
          "pdf_page_end": 178,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "5",
      "origin": "independently_authored"
    }
  ],
