  "grammar_points": [
    {
      "id": "3a25fe9e-c3a6-4083-ac71-70cabfef3b79",
      "editorial_key": "topic_1",
      "title": {
        "en": "Polite and plain forms",
        "vi": "Dạng lịch sự và dạng thông thường"
      },
      "explanation": {
        "en": "Verbs use dictionary, ない, た and なかった forms for the four polite-form equivalents. い-adjectives drop です; な-adjectives and nouns use だ, じゃない, だった and じゃなかった.",
        "vi": "Động từ có dạng từ điển／ない／た／なかった tương ứng với bốn dạng lịch sự. Tính từ い bỏ です; tính từ な và danh từ dùng だ、じゃない、だった、じゃなかった."
      },
      "notes": {
        "en": "Do not add だ after an い-adjective. Plain forms still distinguish tense and negation.",
        "vi": "Không thêm だ sau tính từ い. Dạng thông thường vẫn cần chia thời và phủ định."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 147,
          "pdf_page_end": 148,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "1",
      "origin": "independently_authored"
    },
    {
      "id": "659f08d7-0628-4434-b6a4-c369fd82d56c",
      "editorial_key": "topic_2",
      "title": {
        "en": "Choose a suitable speech style",
        "vi": "Chọn mức lịch sự phù hợp"
      },
      "explanation": {
        "en": "Use polite style with new acquaintances or where social distance calls for respect; plain style suits close relationships and certain written genres.",
        "vi": "Dùng lịch sự khi mới gặp hoặc khi quan hệ cần tôn trọng; dạng thông thường hợp với quan hệ thân và một số thể loại viết."
      },
      "notes": {
        "en": "Do not switch to informal speech merely because the listener is the same age.",
        "vi": "Không tự chuyển sang thân mật chỉ vì người nghe cùng tuổi."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 147,
          "pdf_page_end": 148,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "2",
      "origin": "independently_authored"
    },
    {
      "id": "c9b4ef65-6851-4d6d-ba0e-53802e8a5939",
      "editorial_key": "topic_3",
      "title": {
        "en": "Casual conversation",
        "vi": "Hội thoại thân mật"
      },
      "explanation": {
        "en": "In casual speech questions often use rising intonation without か; だ is normally omitted in noun and な-adjective questions. Understood particles and the い in ている may be omitted; けど links a contrast or introduces an invitation.",
        "vi": "Trong hội thoại thân, câu hỏi thường lên giọng mà không có か; だ thường lược trong câu hỏi danh từ／な. Có thể lược trợ từ đã rõ và い trong ている; けど nối ý tương phản hoặc dẫn vào lời mời."
      },
      "notes": {
        "en": "Do not freely omit で, に, から, まで or と if doing so obscures the relation. A question mark makes the written example’s intonation clear.",
        "vi": "Không lược tùy ý で、に、から、まで、と khi làm mất quan hệ ý nghĩa. Dùng dấu hỏi để thể hiện câu hỏi trong ví dụ viết."
      },
      "source_refs": [
        {
          "source_id": "N5_GRAMMAR",
          "pdf_page_start": 147,
          "pdf_page_end": 148,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "3",
      "origin": "independently_authored"
    }
  ],
