  "grammar_points": [
    {
      "id": "05200817-6a40-4004-84e8-357953eb99e3",
      "editorial_key": "causative_form",
      "title": {
        "en": "Forming causatives",
        "vi": "Tạo thể sai khiến"
      },
      "explanation": {
        "en": "Group I changes the ending to あ-row plus せる; Group II replaces る with させる; する becomes させる and 来る becomes 来させる.",
        "vi": "Nhóm I đổi âm cuối sang hàng あ + せる; nhóm II thay る bằng させる; する thành させる, くる thành こさせる."
      },
      "notes": {
        "en": "Group I verbs ending in う use わせる. The new verb conjugates as Group II.",
        "vi": "Nhóm I tận cùng う dùng わせる. Động từ mới chia như nhóm II."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 165,
          "pdf_page_end": 165,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "1",
      "origin": "independently_authored"
    },
    {
      "id": "a341899b-cced-416d-b018-56b2967b8e36",
      "editorial_key": "causative_particles",
      "title": {
        "en": "を and に in causatives",
        "vi": "を và に trong sai khiến"
      },
      "explanation": {
        "en": "With an intransitive verb the causee usually takes を; with a transitive verb the causee takes に and the object を. If an intransitive already marks a path with を, use に for the causee.",
        "vi": "Với nội động từ thường dùng người を; với ngoại động từ dùng người に và tân ngữ を. Khi nội động từ đã có đường đi を, dùng người に để tránh hai を."
      },
      "notes": {
        "en": "Choose particles from the base verb's structure, not from the translation make or let.",
        "vi": "Chọn trợ từ theo cấu trúc hành động gốc, không theo bản dịch ép hay cho."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 165,
          "pdf_page_end": 166,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "2",
      "origin": "independently_authored"
    },
    {
      "id": "936642ba-bbb4-4ddb-928d-328e136deba4",
      "editorial_key": "causative_meaning",
      "title": {
        "en": "Making and allowing",
        "vi": "Bắt làm và cho phép"
      },
      "explanation": {
        "en": "A causative can express compulsion or permission, depending on the relationship and context.",
        "vi": "Sai khiến có thể là bắt buộc hoặc cho phép, tùy quan hệ và ngữ cảnh."
      },
      "notes": {
        "en": "Do not freely use it to command a superior; favors usually use giving-and-receiving constructions.",
        "vi": "Không tùy ý dùng để sai cấp trên; nhờ giúp thường dùng cấu trúc cho nhận hành vi."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 166,
          "pdf_page_end": 166,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "3",
      "origin": "independently_authored"
    },
    {
      "id": "addbae94-d127-4a12-a33b-7d958ac3c4ff",
      "editorial_key": "permission_request",
      "title": {
        "en": "Politely requesting permission",
        "vi": "Xin phép được làm"
      },
      "explanation": {
        "en": "Causative て-form plus いただけませんか politely asks the listener to allow the speaker to act.",
        "vi": "Thể て của sai khiến + いただけませんか xin người nghe cho phép người nói thực hiện việc."
      },
      "notes": {
        "en": "The requester performs the base action; this does not ask the listener to do it instead.",
        "vi": "Người xin phép là người làm hành động gốc, không phải yêu cầu người nghe làm thay."
      },
      "source_refs": [
        {
          "source_id": "N4_GRAMMAR",
          "pdf_page_start": 166,
          "pdf_page_end": 166,
          "basis": "grammar_knowledge_alignment"
        }
      ],
      "source_topic_group": "4",
      "origin": "independently_authored"
    }
  ],
